{
  "_comment": [
    "Ordered regex substitutions applied to every Parakeet transcript.",
    "Rules are compiled once at startup and applied top-to-bottom, so put",
    "multi-word phrases BEFORE single-word fallbacks. All patterns are",
    "matched case-insensitive; the replacement string is literal.",
    "See handover §7 and samples/accuracy.md for observed mis-transcriptions."
  ],
  "substitutions": [
    { "pattern": "\\bdependa ?bot\\b",                        "replacement": "Dependabot" },
    { "pattern": "\\bdependable\\b(?=\\s+(?:workflow|action|config|update|pr|pull|bot))", "replacement": "Dependabot" },
    { "pattern": "\\bgleeton\\b",                             "replacement": "Gluetun" },
    { "pattern": "\\bgloo ?ten\\b",                           "replacement": "Gluetun" },
    { "pattern": "\\bgluten\\b",                              "replacement": "Gluetun" },
    { "pattern": "\\bcue ?bit ?torrent\\b",                   "replacement": "qBittorrent" },
    { "pattern": "\\bq bit torrent\\b",                       "replacement": "qBittorrent" },
    { "pattern": "\\bcubi ?torrent\\b",                       "replacement": "qBittorrent" },
    { "pattern": "\\bcubit torrent\\b",                       "replacement": "qBittorrent" },
    { "pattern": "\\bpeak ?vector\\b",                        "replacement": "pgvector" },
    { "pattern": "\\bpg ?vector\\b",                          "replacement": "pgvector" },
    { "pattern": "\\bq ?drant\\b",                            "replacement": "Qdrant" },
    { "pattern": "\\bcue ?drant\\b",                          "replacement": "Qdrant" },
    { "pattern": "\\bquadrant\\b",                            "replacement": "Qdrant" },
    { "pattern": "\\bkvadrent\\b",                            "replacement": "Qdrant" },
    { "pattern": "\\bkvadranten\\b",                          "replacement": "Qdrant" },
    { "pattern": "\\bsin ?ology\\b",                          "replacement": "Synology" },
    { "pattern": "\\bsynology\\b",                            "replacement": "Synology" },
    { "pattern": "\\bsynology nose\\b",                       "replacement": "Synology NAS" },
    { "pattern": "\\bhes ?tra\\b",                            "replacement": "Hestra" },
    { "pattern": "\\bhester\\b(?=\\s+(?:gloves|glove))",      "replacement": "Hestra" },
    { "pattern": "\\banon ?in(?:e|a)\\b",                     "replacement": "Anonine" },
    { "pattern": "\\bpro ?ton\\b(?=\\s*vpn)",                 "replacement": "Proton" },
    { "pattern": "\\bgore ?tex\\b",                           "replacement": "Gore-Tex" },
    { "pattern": "\\bss[dh] ?notif",                          "replacement": "DSM notif" },
    { "pattern": "\\bclaude ?code\\b",                        "replacement": "Claude Code" },
    { "pattern": "\\bcloud code\\b",                          "replacement": "Claude Code" },
    { "pattern": "\\banthropic\\b",                           "replacement": "Anthropic" },
    { "pattern": "\\bgar ?min\\b",                            "replacement": "Garmin" },
    { "pattern": "\\bkarmin\\b",                              "replacement": "Garmin" },
    { "pattern": "\\bolama\\b",                               "replacement": "Ollama" },
    { "pattern": "\\bollama\\b",                              "replacement": "Ollama" },
    { "pattern": "\\bolam\\b",                                "replacement": "Ollama" },
    { "pattern": "\\bulama\\b",                               "replacement": "Ollama" },
    { "pattern": "\\bvolama\\b",                              "replacement": "Ollama" },
    { "pattern": "\\bcrates ?i ?o\\b",                        "replacement": "crates.io" },
    { "pattern": "\\btom ?l\\b",                              "replacement": "TOML" },
    { "pattern": "\\btomb\\b(?=\\s+config)",                  "replacement": "TOML" },
    { "pattern": "\\btomorrow\\b(?=\\s+config)",              "replacement": "TOML" },
    { "pattern": "\\bsider\\b(?= |$)",                        "replacement": "CIDR" },
    { "pattern": "\\bsee i d r\\b",                           "replacement": "CIDR" },
    { "pattern": "\\bsidr\\b",                                "replacement": "CIDR" },
    { "pattern": "\\bsiddh\\b",                               "replacement": "CIDR" },
    { "pattern": "\\bcedar\\b(?=\\s+(?:subnet|block|range|address|prefix))", "replacement": "CIDR" },
    { "pattern": "\\bjson\\b",                                "replacement": "JSON" },
    { "pattern": "\\byaml\\b",                                "replacement": "YAML" },
    { "pattern": "\\bdsm\\b",                                 "replacement": "DSM" },
    { "pattern": "\\bn a s\\b",                               "replacement": "NAS" },
    { "pattern": "\\bnas\\b",                                 "replacement": "NAS" },
    { "pattern": "\\bm c p\\b",                               "replacement": "MCP" },
    { "pattern": "\\br a g\\b",                               "replacement": "RAG" },
    { "pattern": "\\brag\\b(?=\\s+(?:pipeline|model|query|index|retrieval))", "replacement": "RAG" },
    { "pattern": "\\brädd\\b(?=\\s+pipeline)",                "replacement": "RAG" },
    { "pattern": "\\bl l m\\b",                               "replacement": "LLM" },
    { "pattern": "\\bvs ?code\\b",                            "replacement": "VS Code" },
    { "pattern": "\\brust(?:_|-)?lang\\b",                    "replacement": "Rust" },
    { "pattern": "\\bpow ?er ?shell\\b",                      "replacement": "PowerShell" },
    { "pattern": "\\bmusic brings\\b",                        "replacement": "MusicBrainz" },
    { "pattern": "\\bmusic brains\\b",                        "replacement": "MusicBrainz" },
    { "pattern": "\\bsend input\\b",                          "replacement": "SendInput" },
    { "pattern": "\\bkey bd(?:\\s+underscore\\s+|_)event\\b",  "replacement": "keybd_event" },
    { "pattern": "\\bwin thirty two\\b",                      "replacement": "Win32" },
    { "pattern": "\\bpaste dot py\\b",                        "replacement": "paste.py" },
    { "pattern": "\\bclickboard\\b",                          "replacement": "clipboard" },
    { "pattern": "\\bfitness coach\\b",                       "replacement": "fitnesscoach" },

    { "pattern": "\\s*\\bfull stop\\b\\.?",                    "replacement": "." },
    { "pattern": "\\s*,\\s*\\bcomma\\b",                       "replacement": "," },
    { "pattern": "\\s+\\bcomma\\b",                            "replacement": "," },
    { "pattern": "\\s+\\bsemicolon\\b",                        "replacement": ";" },
    { "pattern": "\\s+\\bcolon\\b",                            "replacement": ":" },
    { "pattern": "\\bd\\s+column\\s+slash\\b",                 "replacement": "D:\\\\" },
    { "pattern": "\\s+\\bslash\\b\\s+",                        "replacement": "/" },
    { "pattern": "\\s+\\bunderscore\\b\\s+",                   "replacement": "_" },
    { "pattern": "\\s+\\bdash\\b\\s+",                         "replacement": "-" }
  ]
}
